# Just Wiser environment variables.
#
# EVERY VARIABLE HERE IS OPTIONAL. With none of them set, the product is fully
# functional: the customer completes an assessment, sees their recommendation
# and downloads their detailed PDF. What is lost is the internal assessment
# record and the AI rewrite of the explanation, neither of which the customer
# sees or depends on.
#
# These are SERVER-side variables, set in the Vercel project settings. They are
# read only inside the serverless functions in api/ and never reach the
# browser. Do not prefix any of them with VITE_: anything with that prefix is
# compiled into the client bundle and is therefore public.
#
# This file contains PLACEHOLDERS ONLY. Never commit real values. Local
# overrides belong in .env.local, which is gitignored.
#
# Full setup instructions: docs/deployment.md


# ---------------------------------------------------------------------------
# Internal assessment record: Google Sheets
# ---------------------------------------------------------------------------
# One row per completed assessment, for analysis. Contains no personally
# identifying information. The customer never sees this sheet.
# All three of the first variables are required together; if any is missing,
# persistence is skipped and the customer is unaffected.

# The spreadsheet id, taken from the sheet URL between /d/ and /edit.
GOOGLE_SHEETS_ID=your-spreadsheet-id-here

# The service account address from the JSON key file (client_email).
# The sheet must be shared with this address as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The private_key value from the JSON key file, including the BEGIN and END
# lines. Paste it exactly as it appears there, with the \n sequences intact:
# the function converts them into real newlines. Quotes are optional.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The tab within the spreadsheet. Optional: defaults to Assessments.
GOOGLE_SHEET_NAME=Assessments


# ---------------------------------------------------------------------------
# Optional AI explanation layer: Gemini
# ---------------------------------------------------------------------------
# Gemini only rewrites facts the deterministic engine has already calculated.
# It never affects a number or the recommendation. When the key is absent, the
# deterministic template explanation is used instead.

# Your Gemini API key, from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key-here

# The model to use. Optional: defaults to gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash


# ---------------------------------------------------------------------------
# Client-side feature flag (not a secret)
# ---------------------------------------------------------------------------
# Set to true to skip the AI request entirely, for a fully offline demo.
VITE_DISABLE_AI=false
